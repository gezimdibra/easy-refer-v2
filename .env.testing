APP_ENV=testing
APP_NAME="Easy Refer"
# Throwaway key for the test environment only. Not used anywhere else.
APP_KEY=base64:u3zN0eQNuZsINbOPg5yJrJRM70YPcFV6NHSC8oveO1A=
APP_DEBUG=true
# The whole suite runs mounted at the staging mount on purpose (spec
# Section 11.4): the build must pass under a subpath, not only at root.
# BasePathSmokeTest additionally proves the same build at the root mount.
APP_URL=http://localhost/new
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_PATH=/new
SESSION_COOKIE=er2_session
SESSION_SECURE_COOKIE=false

CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=null

PASSWORD_BREACH_SCREENING=true
