APP_NAME="Easy Refer"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# APP_URL is the single config point for the mount (spec Section 11).
# Staging value ends with the staging folder path; production is the bare domain.
APP_URL=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Production database is MariaDB 10.6 on the hosting account (spec Section 7).
# The application DB user holds data manipulation rights only, never DDL.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

<redacted>
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# SESSION_PATH follows the mount: the staging folder path in staging, / in production.
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=er2_session
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Argon2id password hashing (spec Section 8.2, OWASP parameters).
ARGON_MEMORY=19456
ARGON_TIME=2
ARGON_THREADS=1
# Breached-password screening via Have I Been Pwned k-anonymity (spec Section 8.2).
PASSWORD_BREACH_SCREENING=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
<redacted>
MAIL_FROM_NAME="${APP_NAME}"

# Square (spec Section 9). Sandbox in staging, production only after cutover approval.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Pinned at Phase 4 kickoff (spec Section 9.1); empty uses the SDK default.
SQUARE_VERSION=

# Cloudflare Turnstile (spec Section 8.3). Optional: without keys the
# per-account login lock has no challenge bypass; the owner's emailed
# one-time unlock link (Amendment 5) is the way through instead.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Twilio (spec Section 10). Test credentials in staging.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=

VITE_APP_NAME="${APP_NAME}"
